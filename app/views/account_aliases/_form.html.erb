<%# locals: (account:, account_alias:) %>
<%= form_with model: [account, account_alias] do |f| %>
  <%= hidden_field_tag :from, menu.origin_key if menu.origin_key %>
  <%= f.text_field :pattern, placeholder: t("account_aliases.form.pattern_placeholder"),
        required: true %>
  <%= f.submit t("account_aliases.form.submit") %>
<% end %>
