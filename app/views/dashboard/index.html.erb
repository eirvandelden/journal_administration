<% months = @dashboard.selectable_months %>
<article>
  <%= form_with url: dashboard_index_path, method: :get, data: { controller: "submit-on-change" } do |f| %>
    <fieldset>
      <%= f.label :filter, t("dashboard.filters.quick_filter") %>
      <%= f.select :filter, [
            [t("dashboard.filters.current_month"), "current_month"],
            [t("dashboard.filters.last_month"), "last_month"],
            [t("dashboard.filters.three_months"), "three_months"],
            [t("dashboard.filters.current_year"), "current_year"],
            [t("dashboard.filters.last_year"), "last_year"]
          ], { include_blank: "-- #{t("dashboard.filters.select")} --", selected: nil },
          data: { action: "change->submit-on-change#submit" } %>
    </fieldset>

    <fieldset>
      <%= f.label :from_month, t("dashboard.filters.from_month") %>
      <%= f.select :from_month, month_options(months, selected: @dashboard.date_range.start_date.to_date) %>
    </fieldset>

    <fieldset>
      <%= f.label :to_month, t("dashboard.filters.to_month") %>
      <%= f.select :to_month, month_options(months, selected: @dashboard.date_range.end_date.to_date) %>
    </fieldset>

    <button type="submit"><%= t("dashboard.filters.apply") %></button>
  <% end %>
</article>

<article>
  <section class="chart-section">
    <h2><%= t("dashboard.charts.spending_by_category") %></h2>
    <%= svg_donut_chart(labels: @dashboard.chart_labels, data: @dashboard.credit_transactions.values.map { |cents| Cents.to_euros(cents).to_f }) %>
  </section>
</article>

<article>
  <%= render partial: "dashboard/balance", locals: { dashboard: @dashboard } %>
</article>

<article>
  <section class="chart-section">
    <h2>
      <% if @dashboard.active_budget %>
        <%= t("dashboard.charts.budget_vs_actual") %>
      <% else %>
        <%= t("dashboard.charts.spending_vs_average") %>
      <% end %>
    </h2>
    <% if @dashboard.active_budget %>
      <%= svg_budget_chart(
        budget_amounts: @dashboard.budget_amounts.transform_values { |cents| Cents.to_euros(cents).to_f },
        budget_actuals: @dashboard.budget_actuals.transform_values { |cents| Cents.to_euros(cents).to_f }
      ) %>
    <% else %>
      <%= svg_bar_chart(labels: @dashboard.chart_labels,
                        data: @dashboard.credit_transactions.values.map { |cents| Cents.to_euros(cents).to_f },
                        reference: @dashboard.historical_averages.map { |cents| Cents.to_euros(cents).to_f },
                        y_label: t("dashboard.charts.spending_vs_average")) %>
    <% end %>
  </section>
</article>
