<!DOCTYPE html>
<html
  lang="<%= I18n.locale %>"
  data-controller="theme"
  data-color-scheme="<%= theme_attributes[:"data-color-scheme"] %>"
  data-light-theme="<%= theme_attributes[:"data-light-theme"] %>"
  data-dark-theme="<%= theme_attributes[:"data-dark-theme"] %>"
  data-theme="<%= theme_attributes[:"data-theme"] %>">
  <head>
    <title><%= content_for(:title).presence || Appkit.config.app_name.call %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="view-transition" content="same-origin">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "appkit/shared/pwa_meta" %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbo-track': 'reload' %>

    <%= javascript_importmap_tags %>
  </head>
  <body data-controller="search-dialog">
    <%= render "appkit/shared/skip_link" %>
    <header>
      <%= render layout: "appkit/shared/nav", locals: { menu: menu } do %>
        <search>
          <button type="button"
                  data-action="click->search-dialog#open"
                  aria-label="<%= t('search.open') %>">
            <%= t("search.open") %>
          </button>
        </search>
      <% end %>
    </header>
    <main id="main">
      <%= render "appkit/shared/flashes" %>
      <%= yield %>
    </main>
    <dialog id="search-dialog"
            data-search-dialog-target="dialog"
            data-action="click->search-dialog#handleBackdropClick">
      <article>
        <form action="<%= searches_path %>"
              method="get"
              data-turbo-frame="search-results"
              data-search-dialog-target="form">
          <input type="search"
                 name="q"
                 placeholder="<%= t('search.placeholder') %>"
                 autocomplete="off"
                 data-search-dialog-target="input"
                 data-action="input->search-dialog#debounceSearch">
          <small class="search-shortcut"><%= t("search.shortcut_hint") %></small>
        </form>
        <turbo-frame id="search-results">
        </turbo-frame>
      </article>
    </dialog>
  </body>
</html>
