<%# locals: (receipt:) %>
<section>
  <h2><%= t("receipts.basket.heading") %></h2>

  <table>
    <thead>
      <tr>
        <th><%= t("receipts.basket.product") %></th>
        <th><%= t("receipts.basket.quantity") %></th>
        <th><%= t("receipts.basket.shelf_price") %></th>
        <th><%= t("receipts.basket.bonus") %></th>
        <th><%= t("receipts.basket.paid") %></th>
        <th><%= t("receipts.basket.per_unit") %></th>
      </tr>
    </thead>
    <tbody>
      <% receipt.lines.each do |line| %>
        <tr>
          <td><%= line.product.name %></td>
          <td><%= number_with_precision(line.quantity, precision: 3, strip_insignificant_zeros: true) %></td>
          <td><%= number_to_currency(line.full_amount) %></td>
          <td><%= line.on_bonus? ? number_to_currency(line.discount_amount) : "-" %></td>
          <td><%= number_to_currency(line.paid_amount) %></td>
          <td>
            <% if line.paid_price_per_unit %>
              <%= number_to_currency(line.paid_price_per_unit) %> / <%= t("receipts.basket.units.#{line.comparable_unit}") %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <th colspan="4"><%= t("receipts.basket.total") %></th>
        <td><%= number_to_currency(receipt.basket_total) %></td>
        <td></td>
      </tr>
    </tfoot>
  </table>

  <% if receipt.invoice.attached? %>
    <%= link_to t("receipts.basket.view_invoice"), rails_blob_path(receipt.invoice, disposition: :inline) %>
  <% end %>
</section>
