<% content_for(:title) { t("budgets.show.title") } %>
<%= render layout: "shared/title_bar", locals: { title: t("budgets.show.title"), back: budgets_path } do %>
  <%= link_to t("budgets.index.edit"), menu.carry(edit_budget_path(@budget)) %>
<% end %>

<article>
  <dl>
    <dt><%= t("budgets.index.date_range") %></dt>
    <dd><%= @budget %></dd>

    <dt><%= t("budgets.index.status") %></dt>
    <dd>
      <% if @budget.active? %>
        <strong><%= t("budgets.index.active") %></strong>
      <% elsif @budget.future? %>
        <%= t("budgets.index.future") %>
      <% else %>
        <%= t("budgets.index.past") %>
      <% end %>
    </dd>
  </dl>

  <% if @budget.budget_categories.any? %>
    <table>
      <thead>
        <tr>
          <th><%= t("budgets.form.category") %></th>
          <th><%= t("budgets.form.amount") %></th>
        </tr>
      </thead>
      <tbody>
        <% @budget.budget_categories.includes(:category).each do |bc| %>
          <tr>
            <td><%= bc.category.name %></td>
            <td><%= cents_to_currency(bc.amount) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p><%= t("budgets.show.no_categories") %></p>
  <% end %>
</article>
