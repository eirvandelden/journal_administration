<%# locals: (amount:, charged:, overspent:) %>
<% caption = t("appropriations.progress.charged", charged: cents_to_currency(charged), amount: cents_to_currency(amount)) %>
<% bar = tag.progress(caption, max: amount, value: charged.clamp(0, amount), aria: { label: caption }) %>
<% if overspent %>
  <mark title="<%= t("appropriations.balance.overspent") %>"><%= bar %></mark>
<% else %>
  <%= bar %>
<% end %>
