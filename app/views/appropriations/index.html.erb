<% content_for(:title) { t(".heading", year: @year) } %>
<%= render layout: "shared/title_bar", locals: { title: t(".heading", year: @year) } do %>
  <%= link_to t("appropriations.index.previous_year", year: @year - 1), appropriations_path(year: @year - 1) %>
  <%= link_to t("appropriations.index.next_year", year: @year + 1), appropriations_path(year: @year + 1) %>
  <%= link_to t("common.new"), new_appropriation_path %>
<% end %>

<% labels = {
  purpose: Appropriation.human_attribute_name(:purpose),
  amount: Appropriation.human_attribute_name(:amount),
  used: t(".used"),
  balance: t(".balance")
} %>
<article>
  <% if @appropriations.empty? %>
    <p><%= t(".empty", year: @year) %></p>
  <% else %>
    <table data-stack="medium" role="table" aria-label="<%= t(".heading", year: @year) %>">
      <thead role="rowgroup">
        <tr role="row">
          <% labels.each_value do |label| %>
            <th scope="col" role="columnheader"><%= label %></th>
          <% end %>
        </tr>
      </thead>
      <% @appropriations_per_person.each do |name, appropriations| %>
        <tbody role="rowgroup">
          <tr role="row">
            <th scope="rowgroup" colspan="<%= labels.size %>" role="rowheader"><%= name %></th>
          </tr>
          <% appropriations.each do |appropriation| %>
            <tr role="row">
              <td role="cell" data-label="<%= labels[:purpose] %>"><%= link_to appropriation.purpose, appropriation_path(appropriation) %></td>
              <td role="cell" data-label="<%= labels[:amount] %>"><data value="<%= appropriation.amount %>"><%= cents_to_currency(appropriation.amount) %></data></td>
              <td role="cell" data-label="<%= labels[:used] %>"><%= render "appropriations/progress", amount: appropriation.amount, charged: appropriation.charged, overspent: appropriation.overspent? %></td>
              <td role="cell" data-label="<%= labels[:balance] %>"><%= render "appropriations/balance", appropriation: appropriation %></td>
            </tr>
          <% end %>
        </tbody>
      <% end %>
      <% total_amount = @appropriations.sum(&:amount) %>
      <% total_charged = @appropriations.sum(&:charged) %>
      <tfoot role="rowgroup">
        <tr role="row">
          <th role="cell" data-label="<%= labels[:purpose] %>"><%= t(".total") %></th>
          <td role="cell" data-label="<%= labels[:amount] %>"><%= cents_to_currency(total_amount) %></td>
          <td role="cell" data-label="<%= labels[:used] %>"><%= render "appropriations/progress", amount: total_amount, charged: total_charged, overspent: total_charged > total_amount %></td>
          <td role="cell" data-label="<%= labels[:balance] %>"><%= cents_to_currency(total_amount - total_charged) %></td>
        </tr>
      </tfoot>
    </table>
  <% end %>
</article>
