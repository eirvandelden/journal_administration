<% content_for(:title) { @hub.label } %>
<%= render layout: "shared/title_bar", locals: { title: @hub.label } do %>
  <% action = @hub.action %>
  <%= link_to action.label, action.path if action %>
<% end %>

<nav aria-label="<%= @hub.label %>">
  <ul>
    <% @hub.pages.each do |page| %>
      <li>
        <%= menu_entry_to menu.tile_path(page), page do %>
          <span>
            <strong><%= page.label %></strong>
            <% text = tile_text(page) %>
            <% if text %><br><%= text %><% end %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
</nav>
