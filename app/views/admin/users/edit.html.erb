<% content_for(:title) { t(".title") } %>
<%= render layout: "shared/title_bar", locals: { title: t(".title"), back: admin_users_path } do %>
  <%= link_to t("common.show"), menu.carry(admin_user_path(@user)) %>
<% end %>

<article>
  <%= render "admin/users/form",
             user: @user,
             url: admin_user_path(@user),
             submit_label: t(".submit"),
             cancel_path: menu.carry(admin_user_path(@user)) %>
</article>
