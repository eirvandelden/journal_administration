<%# locals: (title:, back: nil) %>
<% controls = yield %>
<% back_link = menu.back(back) %>
<header>
  <h1><%= title %></h1>
  <nav>
    <%= link_to "‹ #{back_link.label}", back_link.path if back_link %>
    <%= controls %>
    <button type="button" data-action="click->search-dialog#open" aria-label="<%= t("search.open") %>">🔍</button>
  </nav>
</header>
